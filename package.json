{
  "name": "juror-ai",
  "version": "1.4.7",
  "description": "Multi-model PR review that shows you the bill. Duplicate findings collapse into one, with optional agreement filtering.",
  "homepage": "https://juror.dev",
  "bugs": {
    "url": "https://github.com/Juror-AI/juror/issues"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "juror": "./dist/cli.js",
    "juror-ai": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "prepack": "npm run build",
    "dev": "tsc -p tsconfig.json --watch",
    "docs:compatibility": "npm run build && node scripts/render-compatibility.mjs",
    "check:compatibility": "node scripts/render-compatibility.mjs --check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:secure-refs": "node scripts/check-action-pins.mjs",
    "test": "vitest run --dir test",
    "test:watch": "vitest --dir test",
    "juror": "node --experimental-strip-types src/cli.ts",
    "cloud:dev": "npm --prefix cloud run dev",
    "cloud:build": "npm --prefix cloud run build",
    "cloud:typecheck": "npm --prefix cloud run typecheck && npm --prefix cloud run typecheck:worker",
    "cloud:test": "npm --prefix cloud test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "playwright": "1.63.0",
    "undici": "6.28.0",
    "yaml": "^2.6.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "code-review",
    "pull-request",
    "github-action",
    "llm",
    "ai-review",
    "consensus",
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "agent-tools",
    "chatgpt",
    "codex",
    "github-pr-review"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Juror-AI/juror.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
